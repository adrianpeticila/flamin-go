{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flamin-go",
  "main": "worker.js",
  "compatibility_date": "2026-06-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "AGENT_STORE",
      "id": "flamingo_agent_store"
    }
  ]
}
